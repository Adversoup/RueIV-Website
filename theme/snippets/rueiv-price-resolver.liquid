{%- comment -%}
  snippets/rueiv-price-resolver.liquid
  ────────────────────────────────────
  Determines whether a product should show price UI.
  Data-driven via override.price_hidden metafield; also treats zero/blank
  variant price as hidden (trade/quote catalog convention).

  Approved storefront customers may see authoritative variant price when:
  - customer tag is trade / trade-approved / price-visible, OR
  - customer metafield rueiv.price_access == approved

  Shopify Admin staff login does NOT populate Liquid `customer`; verify with a
  real storefront customer account tagged for trade access.

  Sets: rueiv_show_price (boolean), rueiv_price_hidden (boolean)

  Usage:
    {% render 'rueiv-price-resolver', product: product %}
{%- endcomment -%}

{%- liquid
  assign rueiv_price_hidden = false
  assign _hidden_meta = product.metafields.override.price_hidden.value

  if _hidden_meta == true or _hidden_meta == 'true' or _hidden_meta == 1
    assign rueiv_price_hidden = true
  endif

  assign _variant = product.selected_or_first_available_variant
  assign _price = _variant.price

  if _price == blank or _price == 0
    assign rueiv_price_hidden = true
  endif

  assign rueiv_show_price = true
  if rueiv_price_hidden
    assign rueiv_show_price = false
  endif

  if customer and rueiv_show_price == false and _price != blank and _price > 0
    assign _price_access = customer.metafields.rueiv.price_access.value
    if _price_access == 'approved' or _price_access == true or _price_access == 'true'
      assign rueiv_show_price = true
    endif

    for _tag in customer.tags
      assign _tag_key = _tag | downcase | strip
      if _tag_key == 'trade' or _tag_key == 'trade-approved' or _tag_key == 'price-visible'
        assign rueiv_show_price = true
        break
      endif
    endfor
  endif
-%}
