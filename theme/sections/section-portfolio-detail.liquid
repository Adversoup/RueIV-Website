{%- comment -%}
  RueIV Portfolio Detail — Full case-study layout with hero image,
  specs table, body text, credits, vendors, gallery, and related products.
  Used on Individual Portfolio pages.
{%- endcomment -%}

<style>
  .rv-portfolio { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .rv-portfolio__hero { margin-bottom: 3rem; border-radius: var(--card-corner-radius, 0); overflow: hidden; }
  .rv-portfolio__hero img { width: 100%; height: auto; display: block; }

  .rv-portfolio__meta {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;
    margin-bottom: 3rem;
  }
  .rv-portfolio__specs { list-style: none; padding: 0; margin: 0; }
  .rv-portfolio__specs li {
    display: flex; justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    font-size: 1.2rem;
  }
  .rv-portfolio__specs-label { font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  .rv-portfolio__body { max-width: 720px; }
  .rv-portfolio__body h2 {
    font-family: var(--font-heading-family); font-size: 1.8rem;
    margin: 0 0 1rem;
  }
  .rv-portfolio__body .rte { font-size: 1.2rem; line-height: 1.7; }

  /* Credits */
  .rv-portfolio__credits {
    margin: 2.5rem 0;
    padding: 2rem;
    background: rgba(0,0,0,0.02);
    border-radius: 6px;
  }
  .rv-portfolio__credits-title {
    font-family: var(--font-heading-family); font-size: 1.4rem;
    font-weight: 600; margin: 0 0 1.25rem;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .rv-portfolio__credits-list { list-style: none; padding: 0; margin: 0; }
  .rv-portfolio__credits-list li {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    font-size: 1.2rem;
  }
  .rv-portfolio__credits-list li:last-child { border-bottom: none; }
  .rv-portfolio__credit-role { font-weight: 600; opacity: 0.7; }
  .rv-portfolio__credit-name a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  /* Vendors */
  .rv-portfolio__vendors {
    margin: 2rem 0;
  }
  .rv-portfolio__vendors-title {
    font-family: var(--font-heading-family); font-size: 1.4rem;
    font-weight: 600; margin: 0 0 1rem;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .rv-portfolio__vendor-tags {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .rv-portfolio__vendor-tag {
    display: inline-flex; align-items: center;
    padding: 0.4rem 1rem;
    font-size: 1.2rem; font-weight: 500;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 20px;
    text-decoration: none; color: inherit;
    transition: all 0.2s ease;
  }
  .rv-portfolio__vendor-tag:hover { background: rgba(0,0,0,0.04); }

  .rv-portfolio__gallery-title {
    font-family: var(--font-heading-family); font-size: 1.5rem;
    text-align: center; margin: 3rem 0 1.5rem;
  }
  .rv-portfolio__gallery {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .rv-portfolio__gallery img {
    width: 100%; height: auto; display: block;
    border-radius: var(--card-corner-radius, 0);
  }

  /* Related products */
  .rv-portfolio__related {
    margin-top: 3rem; padding-top: 2.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .rv-portfolio__related-title {
    font-family: var(--font-heading-family); font-size: 1.5rem;
    text-align: center; margin: 0 0 1.5rem;
  }
  .rv-portfolio__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .rv-portfolio__related-card {
    text-decoration: none; color: inherit;
    text-align: center;
  }
  .rv-portfolio__related-card img {
    width: 100%; aspect-ratio: 1/1; object-fit: cover;
    border-radius: var(--card-corner-radius, 4px);
    margin-bottom: 0.75rem;
  }
  .rv-portfolio__related-card-title {
    font-size: 1.2rem; font-weight: 600;
  }
  .rv-portfolio__related-card-price {
    font-size: 1.2rem; opacity: 0.6; margin-top: 0.25rem;
  }

  @media (max-width: 749px) {
    .rv-portfolio__meta { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>

<section class="rv-portfolio color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.hero_image != blank -%}
      <div class="rv-portfolio__hero">
        {{ section.settings.hero_image | image_url: width: 1800 | image_tag:
            loading: 'eager',
            sizes: '(max-width: 749px) 100vw, 1200px',
            widths: '600,900,1200,1600,1800'
        }}
      </div>
    {%- endif -%}

    <div class="rv-portfolio__meta">
      <div class="rv-portfolio__body">
        {%- if section.settings.project_title != blank -%}
          <h2>{{ section.settings.project_title }}</h2>
        {%- endif -%}
        {%- if section.settings.body_text != blank -%}
          <div class="rte">{{ section.settings.body_text }}</div>
        {%- endif -%}
      </div>
      <div>
        <ul class="rv-portfolio__specs">
          {%- if section.settings.spec_client != blank -%}
            <li><span class="rv-portfolio__specs-label">Client</span><span>{{ section.settings.spec_client }}</span></li>
          {%- endif -%}
          {%- if section.settings.spec_location != blank -%}
            <li><span class="rv-portfolio__specs-label">Location</span><span>{{ section.settings.spec_location }}</span></li>
          {%- endif -%}
          {%- if section.settings.spec_scope != blank -%}
            <li><span class="rv-portfolio__specs-label">Scope</span><span>{{ section.settings.spec_scope }}</span></li>
          {%- endif -%}
          {%- if section.settings.spec_year != blank -%}
            <li><span class="rv-portfolio__specs-label">Year</span><span>{{ section.settings.spec_year }}</span></li>
          {%- endif -%}
          {%- if section.settings.spec_custom_label != blank -%}
            <li><span class="rv-portfolio__specs-label">{{ section.settings.spec_custom_label }}</span><span>{{ section.settings.spec_custom_value }}</span></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    {%- comment -%} Credits {%- endcomment -%}
    {%- assign credit_blocks = section.blocks | where: 'type', 'credit' -%}
    {%- if credit_blocks.size > 0 -%}
      <div class="rv-portfolio__credits">
        <h3 class="rv-portfolio__credits-title">{{ section.settings.credits_heading | default: 'Credits' }}</h3>
        <ul class="rv-portfolio__credits-list">
          {%- for block in credit_blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="rv-portfolio__credit-role">{{ block.settings.role }}</span>
              <span class="rv-portfolio__credit-name">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.name }}</a>
                {%- else -%}
                  {{ block.settings.name }}
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} Vendors {%- endcomment -%}
    {%- assign vendor_blocks = section.blocks | where: 'type', 'vendor' -%}
    {%- if vendor_blocks.size > 0 -%}
      <div class="rv-portfolio__vendors">
        <h3 class="rv-portfolio__vendors-title">{{ section.settings.vendors_heading | default: 'Vendors & Makers' }}</h3>
        <div class="rv-portfolio__vendor-tags">
          {%- for block in vendor_blocks -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="rv-portfolio__vendor-tag" {{ block.shopify_attributes }}>
                {{ block.settings.name }}
              </a>
            {%- else -%}
              <span class="rv-portfolio__vendor-tag" {{ block.shopify_attributes }}>
                {{ block.settings.name }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Gallery {%- endcomment -%}
    {%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' -%}
    {%- if gallery_blocks.size > 0 -%}
      <h3 class="rv-portfolio__gallery-title">{{ section.settings.gallery_heading | default: 'Project Gallery' }}</h3>
      <div class="rv-portfolio__gallery">
        {%- for block in gallery_blocks -%}
          {%- if block.settings.image != blank -%}
            <div {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  sizes: '(max-width: 749px) 90vw, 400px',
                  widths: '400,600,800'
              }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Related Products (manual) {%- endcomment -%}
    {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}
    {%- if product_blocks.size > 0 -%}
      <div class="rv-portfolio__related">
        <h3 class="rv-portfolio__related-title">{{ section.settings.related_heading | default: 'Products Used' }}</h3>
        <div class="rv-portfolio__related-grid">
          {%- for block in product_blocks -%}
            {%- assign prod = block.settings.product -%}
            {%- if prod != blank -%}
              <a href="{{ prod.url }}" class="rv-portfolio__related-card" {{ block.shopify_attributes }}>
                {%- if prod.featured_image != blank -%}
                  {{ prod.featured_image | image_url: width: 400 | image_tag:
                      loading: 'lazy', sizes: '200px', widths: '200,400'
                  }}
                {%- endif -%}
                <div class="rv-portfolio__related-card-title">{{ prod.title }}</div>
                <div class="rv-portfolio__related-card-price">{{ prod.price | money }}</div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV Portfolio Detail",
  "tag": "section",
  "class": "section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "project_title",
      "label": "Project Title",
      "default": "Riverside Residence"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Project Description"
    },
    {
      "type": "header",
      "content": "Specs"
    },
    {
      "type": "text",
      "id": "spec_client",
      "label": "Client"
    },
    {
      "type": "text",
      "id": "spec_location",
      "label": "Location"
    },
    {
      "type": "text",
      "id": "spec_scope",
      "label": "Scope"
    },
    {
      "type": "text",
      "id": "spec_year",
      "label": "Year"
    },
    {
      "type": "text",
      "id": "spec_custom_label",
      "label": "Custom Spec Label"
    },
    {
      "type": "text",
      "id": "spec_custom_value",
      "label": "Custom Spec Value"
    },
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "text",
      "id": "credits_heading",
      "label": "Credits Heading",
      "default": "Credits"
    },
    {
      "type": "text",
      "id": "vendors_heading",
      "label": "Vendors Heading",
      "default": "Vendors & Makers"
    },
    {
      "type": "text",
      "id": "gallery_heading",
      "label": "Gallery Heading",
      "default": "Project Gallery"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related Products Heading",
      "default": "Products Used"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text"
        }
      ]
    },
    {
      "type": "credit",
      "name": "Credit",
      "settings": [
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Interior Designer"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name / Company",
          "default": "Studio Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Vendor Name",
          "default": "Fabricut"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Vendor Link"
        }
      ]
    },
    {
      "type": "product",
      "name": "Related Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV Portfolio Detail"
    }
  ]
}
{% endschema %}
