<style>
  .rueiv-ready { margin-block-start: 0 !important; min-height: 100vh; display: flex; align-items: center; padding: 80px 0; }

  /* Slider */
  .rueiv-qs__slider { position: relative; overflow: hidden; padding: 0 60px; width: 100%; }
  .rueiv-qs__track { display: flex; gap: 20px; transition: transform 0.5s ease; }
  .rueiv-qs__card { flex: 0 0 calc(33.333% - 14px); text-decoration: none; color: inherit; }
  .rueiv-qs__img-wrap { aspect-ratio: 3/4; overflow: hidden; background: #e8e5e0; position: relative; }
  .rueiv-qs__img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .rueiv-qs__card:hover .rueiv-qs__img-wrap img { transform: scale(1.04); }
  .rueiv-qs__img-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.18); transition: background 0.3s; }
  .rueiv-qs__card:hover .rueiv-qs__img-overlay { background: rgba(0,0,0,0.30); }
  .rueiv-qs__img-label { font-family: var(--font-heading-family); font-size: clamp(18px, 2vw, 28px); font-weight: 300; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; text-shadow: 0 2px 6px rgba(0,0,0,0.5); }

  /* Counter */
      .rueiv-qs__counter { display: flex; justify-content: flex-end; align-items: center; gap: 16px; font-family: var(--font-heading-family); font-size: 14px; letter-spacing: 0.14em; margin-bottom: 16px; padding-right: 60px; }
  .rueiv-qs__counter button { background: none; border: none; cursor: pointer; font-size: 18px; padding: 4px 8px; color: #1a1a1a; opacity: 0.5; transition: opacity 0.2s; }
  .rueiv-qs__counter button:hover { opacity: 1; }
  .rueiv-qs__counter button:disabled { opacity: 0.2; cursor: default; }
  .rueiv-qs__counter span { opacity: 0.5; }

  @media (max-width: 767px) {
    .rueiv-qs__slider { padding: 0 20px; }
    .rueiv-qs__card { flex: 0 0 calc(50% - 10px); }
    .rueiv-qs__counter { right: 20px; }
  }
</style>
<section class="rueiv-section rueiv-ready">
  <div class="rueiv-page-width" style="width:100%;">
    {%- if section.settings.heading != blank -%}
      <h2 class="rueiv-section-heading" style="text-align: center;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="rueiv-qs__counter">
        <button data-qs-prev aria-label="Previous">&lsaquo;</button>
        <span data-qs-current>1</span>
        <span>/</span>
        <span data-qs-total>1</span>
        <button data-qs-next aria-label="Next">&rsaquo;</button>
      </div>
      <div class="rueiv-qs__slider" data-qs-slider>
      <div class="rueiv-qs__track" data-qs-track>
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '/collections/quick-ship' }}" class="rueiv-qs__card" data-qs-slide>
            <div class="rueiv-qs__img-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <div class="rueiv-pcard__placeholder"></div>
              {%- endif -%}
              <div class="rueiv-qs__img-overlay">
                <span class="rueiv-qs__img-label">{{ block.settings.title }}</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var slider = document.querySelector('[data-qs-slider]');
  if (!slider) return;
  var track = slider.querySelector('[data-qs-track]');
  var cards = slider.querySelectorAll('[data-qs-slide]');
  var prevBtn = document.querySelector('[data-qs-prev]');
  var nextBtn = document.querySelector('[data-qs-next]');
  var curEl = document.querySelector('[data-qs-current]');
  var totalEl = document.querySelector('[data-qs-total]');
  var index = 0;
  var total = cards.length;
  totalEl.textContent = total;
  curEl.textContent = 1;

  function update() {
    var cardW = cards[0] ? cards[0].offsetWidth + 20 : 0;
    track.style.transform = 'translateX(-' + (index * cardW) + 'px)';
    curEl.textContent = index + 1;
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index >= total - 3;
  }

  prevBtn.addEventListener('click', function(){ if (index > 0) { index--; update(); } });
  nextBtn.addEventListener('click', function(){ if (index < total - 3) { index++; update(); } });
  window.addEventListener('resize', update);
  update();
})();
</script>

{% schema %}
{
  "name": "RueIV — Quick Ship",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Ship" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Category Name", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV — Quick Ship",
      "settings": { "heading": "Quick Ship" },
      "blocks": [
        { "type": "category", "settings": { "title": "Furniture" } },
        { "type": "category", "settings": { "title": "Seating" } },
        { "type": "category", "settings": { "title": "Tables" } },
        { "type": "category", "settings": { "title": "Case Goods" } },
        { "type": "category", "settings": { "title": "Rugs" } },
        { "type": "category", "settings": { "title": "Lighting" } },
        { "type": "category", "settings": { "title": "Lamps" } },
        { "type": "category", "settings": { "title": "Pendants" } },
        { "type": "category", "settings": { "title": "Wall Lights" } },
        { "type": "category", "settings": { "title": "Mirrors" } },
        { "type": "category", "settings": { "title": "Accessories" } },
        { "type": "category", "settings": { "title": "Floor Display" } }
      ]
    }
  ]
}
{% endschema %}
