{%- comment -%}
  Main Product – Moodboard template
  Lookbook-style hierarchical image grid + variant picker + ATC
{%- endcomment -%}

{{ 'moodboard-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'MoodboardForm-' | append: section.id
-%}

<div class="moodboard section section--padding" style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;">

  {%- comment -%}── Header ──{%- endcomment -%}
  <div class="moodboard__header">
    <h1 class="moodboard__title">{{ product.title }}</h1>
    {%- if product.description != blank -%}
      <div class="moodboard__description rte">{{ product.description }}</div>
    {%- endif -%}
    {%- if product.tags.size > 0 -%}
      <div class="moodboard__tags">
        {%- for tag in product.tags -%}
          {%- unless tag contains '_' or tag contains ':' -%}
            <span class="moodboard__tag">{{ tag }}</span>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}── Lookbook Grid ──{%- endcomment -%}
  {%- if product.media.size > 0 -%}
    {%- assign img_count = product.media.size -%}
    {%- if img_count > 10 -%}{%- assign img_count = 10 -%}{%- endif -%}
    <div class="moodboard__grid" data-count="{{ img_count }}">
      {%- for media in product.media limit: 10 -%}
        <div class="moodboard__cell">
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1200',
              sizes: '(max-width: 749px) 50vw, 33vw',
              alt: media.alt | default: product.title
            }}
          {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
            {{ media | media_tag: autoplay: true, loop: true, muted: true, controls: false }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%}── Purchase Section ──{%- endcomment -%}
  <div class="moodboard__purchase">
    {%- comment -%} Variant Picker {%- endcomment -%}
    {%- unless product.has_only_default_variant -%}
      <div class="moodboard__variants">
        {%- for option in product.options_with_values -%}
          <div class="moodboard__variant-group" data-option-index="{{ forloop.index0 }}">
            <span class="moodboard__variant-label">{{ option.name }}</span>
            <div class="moodboard__variant-options">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="moodboard__variant-btn{% if option.selected_value == value %} is-active{% endif %}"
                  data-option-value="{{ value | escape }}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div class="moodboard__palette" data-moodboard-palette>
      <h2 class="moodboard__palette-title">Refine the palette</h2>
      <p class="moodboard__palette-help">Choose up to four colors from this moodboard.</p>
      <div class="moodboard__palette-grid">
        {%- for palette_index in (1..4) -%}
          <label class="moodboard__palette-swatch">
            <span class="sr-only">Palette color {{ palette_index }}</span>
            <input type="color" value="#d8d0c5" data-palette-color="{{ palette_index }}" aria-label="Palette color {{ palette_index }}">
            <span class="moodboard__palette-value" data-palette-value="{{ palette_index }}">#D8D0C5</span>
          </label>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Add to Cart Form {%- endcomment -%}
    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-moodboard-variant-id>
      <input type="hidden" name="quantity" value="1">
      {%- for palette_index in (1..4) -%}
        <input type="hidden" name="properties[Color {{ palette_index }} HEX]" value="#D8D0C5" data-palette-hex="{{ palette_index }}">
        <input type="hidden" name="properties[Color {{ palette_index }} RGB]" value="rgb(216, 208, 197)" data-palette-rgb="{{ palette_index }}">
      {%- endfor -%}
      <button
        type="submit"
        name="add"
        class="moodboard__atc"
        {% if current_variant.available == false %}disabled{% endif %}
      >
        {%- if current_variant.available -%}
          Add to Cart
        {%- else -%}
          Sold Out
        {%- endif -%}
      </button>
    {%- endform -%}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var variants = {{ product.variants | json }};
  var options = [];
  {% for option in product.options_with_values %}
    options.push("{{ option.selected_value | escape }}");
  {% endfor %}

  var btns = document.querySelectorAll('.moodboard__variant-btn');
  var paletteInputs = document.querySelectorAll('[data-palette-color]');
  var paletteImage = document.querySelector('.moodboard__grid img');

  function hexToRgb(hex) {
    var value = hex.replace('#', '');
    var number = parseInt(value, 16);
    return { r: (number >> 16) & 255, g: (number >> 8) & 255, b: number & 255 };
  }

  function updatePalette(index, hex) {
    var rgb = hexToRgb(hex);
    var rgbValue = 'rgb(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ')';
    var value = hex.toUpperCase();
    var hexField = document.querySelector('[data-palette-hex="' + index + '"]');
    var rgbField = document.querySelector('[data-palette-rgb="' + index + '"]');
    var valueLabel = document.querySelector('[data-palette-value="' + index + '"]');
    if (hexField) hexField.value = value;
    if (rgbField) rgbField.value = rgbValue;
    if (valueLabel) valueLabel.textContent = value;
  }

  paletteInputs.forEach(function (input) {
    input.addEventListener('input', function () { updatePalette(this.dataset.paletteColor, this.value); });
    input.addEventListener('click', function () {
      if (window.EyeDropper) {
        var eyedropper = new EyeDropper();
        eyedropper.open().then(function (result) {
          input.value = result.sRGBHex;
          updatePalette(input.dataset.paletteColor, input.value);
        }).catch(function () {});
      }
    });
  });

  function extractPalette() {
    if (!paletteImage || !paletteImage.complete) return;
    var canvas = document.createElement('canvas');
    canvas.width = 32; canvas.height = 32;
    var context = canvas.getContext('2d', { willReadFrequently: true });
    try {
      context.drawImage(paletteImage, 0, 0, 32, 32);
      var pixels = context.getImageData(0, 0, 32, 32).data;
      var samples = [];
      for (var p = 0; p < pixels.length; p += 16) {
        if (pixels[p + 3] > 220) samples.push([pixels[p], pixels[p + 1], pixels[p + 2]]);
      }
      var colors = samples.slice(0, 4);
      colors.forEach(function (color, index) {
        var hex = '#' + color.map(function (part) { return part.toString(16).padStart(2, '0'); }).join('');
        var input = paletteInputs[index];
        if (input) { input.value = hex; updatePalette(index + 1, hex); }
      });
    } catch (error) {}
  }
  if (paletteImage) paletteImage.addEventListener('load', extractPalette);
  extractPalette();
  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var idx = parseInt(this.dataset.optionIndex);
      options[idx] = this.dataset.optionValue;

      // Update active states for this group
      this.closest('.moodboard__variant-options')
        .querySelectorAll('.moodboard__variant-btn')
        .forEach(function (b) { b.classList.remove('is-active'); });
      this.classList.add('is-active');

      // Find matching variant
      var match = variants.find(function (v) {
        return v.options.every(function (o, i) { return o === options[i]; });
      });

      if (match) {
        document.querySelector('[data-moodboard-variant-id]').value = match.id;
        var priceEl = document.querySelector('[data-moodboard-price]');
        var atcBtn = document.querySelector('.moodboard__atc');
        var priceHtml = '';
        if (match.compare_at_price && match.compare_at_price > match.price) {
          priceHtml += '<s>' + formatMoney(match.compare_at_price) + '</s> ';
        }
        priceHtml += formatMoney(match.price);
        priceEl.innerHTML = priceHtml;
        atcBtn.disabled = !match.available;
        atcBtn.textContent = match.available ? 'Add to Cart' : 'Sold Out';

        // Update URL
        var url = new URL(window.location);
        url.searchParams.set('variant', match.id);
        window.history.replaceState({}, '', url);
      }
    });
  });

  function formatMoney(cents) {
    return (cents / 100).toLocaleString('en-US', {
      style: 'currency',
      currency: {{ shop.currency | json }}
    });
  }
});
</script>

{% schema %}
{
  "name": "Moodboard Product",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ]
}
{% endschema %}
