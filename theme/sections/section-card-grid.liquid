{%- comment -%}
  RueIV Card Grid — Repeatable cards with image, title, text, and CTA.
  Use for team members, brand tiles, service offerings, etc.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .rv-cards { padding: var(--section-padding-top) 0 var(--section-padding-bottom); }
  .rv-cards__header { text-align: center; margin-bottom: 2.5rem; }
  .rv-cards__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.2em; text-transform: uppercase;
    opacity: 0.6; margin-bottom: 0.5rem;
  }
  .rv-cards__title {
    font-family: var(--font-heading-family); font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 3vw, 3rem); margin: 0;
  }
  .rv-cards__subtitle {
    font-size: 1.2rem; max-width: 560px; margin: 1rem auto 0; line-height: 1.6; opacity: 0.75;
  }
  .rv-cards__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }
  .rv-card {
    background: var(--color-background);
    border-radius: var(--card-corner-radius, 0);
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    display: flex; flex-direction: column;
  }
  .rv-card__media { position: relative; overflow: hidden; }
  .rv-card__media img {
    width: 100%; aspect-ratio: {{ section.settings.image_ratio | default: '4/3' }};
    object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .rv-card:hover .rv-card__media img { transform: scale(1.03); }
  .rv-card__body { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
  .rv-card__heading {
    font-family: var(--font-heading-family); font-size: 1.4rem; font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .rv-card__text { font-size: 1.2rem; line-height: 1.6; opacity: 0.75; flex: 1; }
  .rv-card__cta { margin-top: 1.25rem; }
  .rv-card__placeholder {
    width: 100%; aspect-ratio: {{ section.settings.image_ratio | default: '4/3' }};
    background: #e8e4df; display: flex; align-items: center; justify-content: center;
    color: #bbb; font-size: 1.2rem;
  }
  @media (max-width: 749px) {
    .rv-cards__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr);
    }
  }
</style>

<section class="rv-cards color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="rv-cards__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rv-cards__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rv-cards__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="rv-cards__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="rv-cards__grid">
        {%- for block in section.blocks -%}
          <div class="rv-card" {{ block.shopify_attributes }}>
            <div class="rv-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 90vw, 400px',
                    widths: '300,400,600,800',
                    is: 'image-lazy'
                }}
              {%- else -%}
                <div class="rv-card__placeholder">Image</div>
              {%- endif -%}
            </div>
            <div class="rv-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="rv-card__heading">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rv-card__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="rv-card__cta">
                  <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--secondary btn--small">
                    {{ block.settings.button_label }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV Card Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 24
    },
    {
      "type": "text",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "default": "4/3",
      "info": "e.g. 4/3, 1/1, 16/9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV Card Grid"
    }
  ]
}
{% endschema %}
