{%- comment -%}
  RueIV Brand Identity — Logo parade, brand values, story content.
  Used on the Brand page.
{%- endcomment -%}

<style>
  .rv-brand { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .rv-brand__header { text-align: center; margin-bottom: 3rem; }
  .rv-brand__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.2em; text-transform: uppercase;
    opacity: 0.6; margin-bottom: 0.5rem;
  }
  .rv-brand__title {
    font-family: var(--font-heading-family); font-size: clamp(2rem, 3vw, 3rem); margin: 0 0 1rem;
  }
  .rv-brand__desc { font-size: 1.2rem; max-width: 640px; margin: 0 auto; line-height: 1.7; opacity: 0.8; }

  .rv-brand__values {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem; margin: 3rem 0;
  }
  .rv-brand__value { text-align: center; }
  .rv-brand__value-icon { font-size: 2.4rem; margin-bottom: 0.75rem; }
  .rv-brand__value-title {
    font-family: var(--font-heading-family); font-size: 1.3rem;
    font-weight: 600; margin-bottom: 0.5rem;
  }
  .rv-brand__value-text { font-size: 1.2rem; line-height: 1.6; opacity: 0.7; }

  .rv-brand__logos {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 2.5rem; margin-top: 3rem; padding-top: 3rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .rv-brand__logos-heading {
    width: 100%; text-align: center;
    font-family: var(--font-heading-family); font-size: 1.3rem;
    text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.5;
    margin-bottom: 0.5rem;
  }
  .rv-brand__logo { max-height: 48px; width: auto; opacity: 0.7; transition: opacity 0.3s; }
  .rv-brand__logo:hover { opacity: 1; }
</style>

<section class="rv-brand color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="rv-brand__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rv-brand__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rv-brand__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="rv-brand__desc rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
    {%- if value_blocks.size > 0 -%}
      <div class="rv-brand__values">
        {%- for block in value_blocks -%}
          <div class="rv-brand__value" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="rv-brand__value-icon">{{ block.settings.icon }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <div class="rv-brand__value-title">{{ block.settings.title }}</div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rv-brand__value-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign logo_blocks = section.blocks | where: 'type', 'brand_logo' -%}
    {%- if logo_blocks.size > 0 -%}
      <div class="rv-brand__logos">
        {%- if section.settings.logos_heading != blank -%}
          <div class="rv-brand__logos-heading">{{ section.settings.logos_heading }}</div>
        {%- endif -%}
        {%- for block in logo_blocks -%}
          {%- if block.settings.logo != blank -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {{ block.settings.logo | image_url: height: 96 | image_tag:
                loading: 'lazy', class: 'rv-brand__logo',
                alt: block.settings.name | default: 'Brand logo'
            }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV Brand Identity",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Brands"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated for the Modern Interior"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "logos_heading",
      "label": "Brand Logos Heading",
      "default": "Brands We Carry"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Brand Value",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✦"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Craftsmanship"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every piece is selected for exceptional quality and enduring design."
        }
      ]
    },
    {
      "type": "brand_logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV Brand Identity",
      "blocks": [
        { "type": "value", "settings": { "icon": "✦", "title": "Craftsmanship", "text": "Every piece is selected for exceptional quality and enduring design." } },
        { "type": "value", "settings": { "icon": "🌿", "title": "Sustainability", "text": "We partner with brands committed to responsible materials and production." } },
        { "type": "value", "settings": { "icon": "🏠", "title": "Trade Expertise", "text": "Dedicated support for architects, designers, and trade professionals." } }
      ]
    }
  ]
}
{% endschema %}
