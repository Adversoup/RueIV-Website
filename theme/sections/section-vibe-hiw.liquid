{%- comment -%}
  RueIV Vibe Studio — How It Works (below hero)
{%- endcomment -%}

<style>
  .rv-vibe-hiw {
    position: relative;
    text-align: center;
    padding: clamp(60px, 8vw, 100px) 24px;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }
  .rv-vibe-hiw__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 0;
  }
  .rv-vibe-hiw__inner {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
  }
  .rv-vibe-hiw__title {
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 200;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 48px;
    color: #fff !important;
  }
  .rv-vibe-hiw__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    margin: 0 0 48px;
  }
  .rv-vibe-hiw__step {
    text-align: center;
    padding: 40px 24px;
    border: 1px solid rgba(255,255,255,0.15);
    counter-increment: hiw-step;
    color: #fff !important;
  }
  .rv-vibe-hiw__step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    color: #fff !important;
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 300;
    margin: 0 0 16px;
  }
  .rv-vibe-hiw__step-title {
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 8px;
    color: #fff !important;
  }
  .rv-vibe-hiw__step-desc {
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
    color: #fff !important;
  }
  .rv-vibe-hiw__copy {
    font-size: 15px;
    line-height: 1.8;
    opacity: 0.85;
    max-width: 640px;
    margin: 0 auto;
    color: #fff !important;
  }
  .rv-vibe-hiw__disclaimer {
    font-size: 14px;
    line-height: 1.7;
    font-style: italic;
    opacity: 0.6;
    max-width: 720px;
    margin: 48px auto 0;
    color: #fff !important;
  }
  @media (max-width: 749px) {
    .rv-vibe-hiw__steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="rv-vibe-hiw">
  {%- if section.settings.bg_asset != blank -%}
    <img src="{{ section.settings.bg_asset | asset_url }}" alt="" class="rv-vibe-hiw__bg" loading="lazy">
  {%- endif -%}
  <div class="rv-vibe-hiw__inner">
  {%- if section.settings.heading != blank -%}
    <h2 class="rv-vibe-hiw__title">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="rv-vibe-hiw__steps" style="counter-reset: hiw-step;">
      {%- for block in section.blocks -%}
        <div class="rv-vibe-hiw__step" {{ block.shopify_attributes }}>
          <div class="rv-vibe-hiw__step-num">{{ forloop.index }}</div>
          {%- if block.settings.title != blank -%}
            <div class="rv-vibe-hiw__step-title">{{ block.settings.title }}</div>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="rv-vibe-hiw__step-desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.copy != blank -%}
    <p class="rv-vibe-hiw__copy">{{ section.settings.copy }}</p>
  {%- endif -%}

  {%- if section.settings.disclaimer != blank -%}
    <p class="rv-vibe-hiw__disclaimer">{{ section.settings.disclaimer }}</p>
  {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV Vibe — How It Works",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "bg_asset",
      "label": "Background Asset Filename",
      "info": "Filename from theme assets (e.g. wall-background.png)"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy (below steps)"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV Vibe — How It Works"
    }
  ]
}
{% endschema %}
