{%- comment -%}
  RueIV Rich Content — Heading + richtext with optional 2-column layout.
  Use on About, Sustainability, Designer Spotlight, or any editorial page.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .rv-rich { padding: var(--section-padding-top) 0 var(--section-padding-bottom); }
  .rv-rich__header { margin-bottom: 2.5rem; }
  .rv-rich__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.2em; text-transform: uppercase;
    opacity: 0.6; margin-bottom: 0.5rem;
  }
  .rv-rich__title {
    font-family: var(--font-heading-family); font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 3vw, 3rem); margin: 0;
  }
  .rv-rich__body {
    font-size: 1.2rem; line-height: 1.75;
  }
  .rv-rich__body h2,
  .rv-rich__body h3 {
    font-family: var(--font-heading-family);
    margin-top: 2rem;
  }
  .rv-rich__body--two-col {
    columns: 2; column-gap: 3rem;
  }
  .rv-rich__cta { margin-top: 2rem; }
  @media (max-width: 749px) {
    .rv-rich__body--two-col { columns: 1; }
  }
</style>

<section class="rv-rich color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="rv-rich__header{% if section.settings.text_align == 'center' %} text-center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rv-rich__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rv-rich__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="rv-rich__body rte{% if section.settings.two_column %} rv-rich__body--two-col{% endif %}{% if section.settings.text_align == 'center' %} text-center{% endif %}">
        {{ section.settings.body }}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="rv-rich__cta{% if section.settings.text_align == 'center' %} text-center{% endif %}">
        <a href="{{ section.settings.cta_link }}" class="btn btn--primary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV Rich Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text"
    },
    {
      "type": "checkbox",
      "id": "two_column",
      "label": "Two-column layout",
      "default": false,
      "info": "Splits the body text into two columns on desktop."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "RueIV Rich Content"
    }
  ]
}
{% endschema %}
