<section class="rueiv-section rueiv-lookbook">
  <div class="rueiv-page-width">
    <div class="rueiv-lookbook__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="rueiv-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="rueiv-lookbook__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="rueiv-lookbook__tile" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="rueiv-lookbook__tile" {{ block.shopify_attributes }}>
          {%- endif -%}

            <div class="rueiv-square-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                   loading: 'lazy', alt: block.settings.caption }}
              {%- else -%}
                <div style="width:100%;height:100%;background:#e8e5e0;"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}
              <p class="rueiv-lookbook__caption">{{ block.settings.caption }}</p>
            {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RueIV — Lookbook",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lookbook" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Lookbook Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV — Lookbook",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
