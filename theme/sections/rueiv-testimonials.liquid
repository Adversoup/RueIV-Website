{%- comment -%}
  ============================================================================
  RueIV Testimonials — Single editorial quote, random on refresh
  ============================================================================
{%- endcomment -%}

<section class="rueiv-testimonials" data-section-id="{{ section.id }}">
  <div class="rueiv-testimonials__bg">
    <img src="{{ 'wall-background.png' | asset_url }}" alt="" loading="lazy">
  </div>
  <div class="rueiv-testimonials__inner page-width">
    {%- if section.settings.heading != blank -%}
      <p class="rueiv-testimonials__eyebrow">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="rueiv-testimonials__track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'quote' -%}
          <blockquote class="rueiv-testimonials__card" data-quote-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <p class="rueiv-testimonials__quote">"{{ block.settings.quote }}"</p>
            {%- if block.settings.author != blank -%}
              <cite class="rueiv-testimonials__author">— {{ block.settings.author }}</cite>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <span class="rueiv-testimonials__role">{{ block.settings.role }}</span>
            {%- endif -%}
          </blockquote>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function(){
    const sec = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sec) return;
    const cards = sec.querySelectorAll('.rueiv-testimonials__card');
    if (cards.length < 1) return;
    /* Pick one random quote on page load */
    var pick = Math.floor(Math.random() * cards.length);
    cards[pick].classList.add('is-active');
  })();
</script>

{% schema %}
{
  "name": "RueIV Testimonials",
  "tag": "section",
  "class": "rueiv-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "IN YOUR WORDS" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "A sourcing platform that simplifies the design process." },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "role", "label": "Role / Title" }
      ]
    }
  ],
  "presets": [{ "name": "RueIV Testimonials" }]
}
{% endschema %}
