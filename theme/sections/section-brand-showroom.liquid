{%- comment -%}
  RueIV Brand Showroom — Optional location / showroom note.
  Address, hours, phone, email, map image, appointment CTA.
{%- endcomment -%}

<style>
  .rv-showroom {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .rv-showroom__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .rv-showroom__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.18em; text-transform: uppercase;
    opacity: 0.5; margin-bottom: 0.5rem;
  }
  .rv-showroom__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    font-weight: var(--font-heading-weight);
    margin: 0 0 1.25rem;
  }
  .rv-showroom__body {
    font-size: 1.2rem; line-height: 1.7; opacity: 0.8;
    margin-bottom: 1.5rem;
  }
  .rv-showroom__details { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .rv-showroom__detail {
    display: flex; gap: 0.75rem; align-items: flex-start;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    font-size: 1.2rem; line-height: 1.5;
  }
  .rv-showroom__detail-icon {
    flex-shrink: 0; width: 1.2em; text-align: center; opacity: 0.5;
  }
  .rv-showroom__detail a {
    color: inherit; text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rv-showroom__cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    font-size: 1.2rem; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; text-decoration: none;
    border: 1px solid currentColor; border-radius: 2px;
    transition: all 0.25s ease;
  }
  .rv-showroom__cta:hover { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
  .rv-showroom__map {
    border-radius: 4px; overflow: hidden;
  }
  .rv-showroom__map img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 4/3; object-fit: cover;
  }
  .rv-showroom__note {
    grid-column: 1 / -1;
    font-size: 1.2rem; opacity: 0.5; text-align: center;
    margin-top: 0.5rem;
  }
  @media (max-width: 749px) {
    .rv-showroom__grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>

<section class="rv-showroom color-{{ section.settings.color_scheme }}" id="showroom">
  <div class="page-width">
    <div class="rv-showroom__grid">
      {%- comment -%} Info column {%- endcomment -%}
      <div class="rv-showroom__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rv-showroom__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rv-showroom__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="rv-showroom__body rte">{{ section.settings.body }}</div>
        {%- endif -%}

        <ul class="rv-showroom__details">
          {%- if section.settings.address != blank -%}
            <li class="rv-showroom__detail">
              <span class="rv-showroom__detail-icon">📍</span>
              <span>{{ section.settings.address }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li class="rv-showroom__detail">
              <span class="rv-showroom__detail-icon">🕐</span>
              <span>{{ section.settings.hours }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li class="rv-showroom__detail">
              <span class="rv-showroom__detail-icon">📞</span>
              <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ section.settings.phone }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li class="rv-showroom__detail">
              <span class="rv-showroom__detail-icon">✉️</span>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {%- endif -%}
        </ul>

        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="rv-showroom__cta">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Map / image column {%- endcomment -%}
      <div class="rv-showroom__map">
        {%- if section.settings.map_image != blank -%}
          {{ section.settings.map_image | image_url: width: 1200 | image_tag:
              loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '400,600,800,1000,1200'
          }}
        {%- else -%}
          <div style="background:#e8e4df;width:100%;aspect-ratio:4/3;"></div>
        {%- endif -%}
      </div>

      {%- if section.settings.disclaimer != blank -%}
        <p class="rv-showroom__note">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RueIV Brand Showroom",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visit Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Showroom"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Contact Details"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "info": "e.g. Mon–Fri 9am–5pm"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Book an Appointment"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Map / Image"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Showroom Image or Map"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer / Note",
      "info": "Small text below both columns."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "RueIV Brand Showroom"
    }
  ]
}
{% endschema %}
