{%- comment -%}
  RueIV Event List — Upcoming events with date, title, location, and link.
  Used on the Events page.
{%- endcomment -%}

<style>
  .rv-events { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .rv-events__header { text-align: center; margin-bottom: 3rem; }
  .rv-events__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.2em; text-transform: uppercase;
    opacity: 0.6; margin-bottom: 0.5rem;
  }
  .rv-events__title { font-family: var(--font-heading-family); font-size: clamp(2rem, 3vw, 3rem); margin: 0; }
  .rv-events__subtitle { font-size: 1.2rem; max-width: 560px; margin: 1rem auto 0; line-height: 1.6; opacity: 0.75; }

  .rv-events__list { list-style: none; padding: 0; margin: 0; }
  .rv-events__item {
    display: grid; grid-template-columns: 120px 1fr auto;
    gap: 2rem; align-items: center;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  .rv-events__item:first-child { border-top: 1px solid rgba(0,0,0,0.08); }

  .rv-events__date {
    text-align: center;
    font-family: var(--font-heading-family);
  }
  .rv-events__date-month {
    font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.6;
  }
  .rv-events__date-day { font-size: 2.4rem; font-weight: 700; line-height: 1.1; }

  .rv-events__info {}
  .rv-events__name {
    font-family: var(--font-heading-family);
    font-size: 1.5rem; font-weight: 600; margin: 0 0 0.25rem;
  }
  .rv-events__location { font-size: 1.2rem; opacity: 0.65; }
  .rv-events__desc { font-size: 1.2rem; margin-top: 0.5rem; line-height: 1.5; }

  .rv-events__action .btn { white-space: nowrap; }

  .rv-events__empty { text-align: center; padding: 4rem 0; font-size: 1.4rem; opacity: 0.6; }

  @media (max-width: 749px) {
    .rv-events__item { grid-template-columns: 80px 1fr; gap: 1rem; }
    .rv-events__action { grid-column: 1 / -1; text-align: center; }
  }
</style>

<section class="rv-events color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="rv-events__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rv-events__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rv-events__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="rv-events__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="rv-events__list">
        {%- for block in section.blocks -%}
          <li class="rv-events__item" {{ block.shopify_attributes }}>
            <div class="rv-events__date">
              {%- if block.settings.date_month != blank -%}
                <div class="rv-events__date-month">{{ block.settings.date_month }}</div>
              {%- endif -%}
              {%- if block.settings.date_day != blank -%}
                <div class="rv-events__date-day">{{ block.settings.date_day }}</div>
              {%- endif -%}
            </div>
            <div class="rv-events__info">
              {%- if block.settings.name != blank -%}
                <h3 class="rv-events__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.location != blank -%}
                <div class="rv-events__location">{{ block.settings.location }}</div>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="rv-events__desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
            {%- if block.settings.cta_label != blank -%}
              <div class="rv-events__action">
                <a href="{{ block.settings.cta_link | default: '#' }}" class="btn btn--primary btn--small">
                  {{ block.settings.cta_label }}
                </a>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="rv-events__empty">No upcoming events — check back soon.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV Event List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Upcoming"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Events"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "text",
          "id": "date_month",
          "label": "Month",
          "default": "MAR"
        },
        {
          "type": "text",
          "id": "date_day",
          "label": "Day",
          "default": "15"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Event Name",
          "default": "Design Week Opening"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "New York, NY"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short Description"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "RSVP"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV Event List"
    }
  ]
}
{% endschema %}
