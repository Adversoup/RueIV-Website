{{ 'rueiv-homepage.css' | asset_url | stylesheet_tag }}

{%- assign slide_count = section.blocks.size -%}

<section class="rueiv-section rueiv-hero" id="rueiv-hero">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="rueiv-hero__slide" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 2400 | image_tag:
             loading: 'eager', class: 'rueiv-hero__img rueiv-hero__img--desktop',
             alt: block.settings.heading }}
          {%- if block.settings.image_mobile != blank -%}
            {{ block.settings.image_mobile | image_url: width: 1200 | image_tag:
               loading: 'eager', class: 'rueiv-hero__img rueiv-hero__img--mobile',
               alt: block.settings.heading }}
          {%- endif -%}
        {%- else -%}
          <img src="{{ 'hero-image.jpg' | asset_url }}" loading="eager"
               class="rueiv-hero__img rueiv-hero__img--desktop"
               alt="{{ section.settings.hero_heading }}">
        {%- endif -%}
        <div class="rueiv-hero__overlay"></div>
      </div>
    {%- endfor -%}
  {%- else -%}
    <!-- No slide blocks — show default hero image -->
    <div class="rueiv-hero__slide is-active">
      <img src="{{ 'hero-image.jpg' | asset_url }}" loading="eager"
           class="rueiv-hero__img rueiv-hero__img--desktop"
           alt="{{ section.settings.hero_heading }}">
      <div class="rueiv-hero__overlay"></div>
    </div>
  {%- endif -%}

  <!-- Centered hero text overlay (always visible) -->
  <div class="rueiv-hero__content rueiv-hero__content--centered">
    <h1 class="rueiv-hero__heading rueiv-hero__heading--huge">{{ section.settings.hero_heading }}</h1>
    {%- if section.settings.hero_subtitle != blank -%}
      <p class="rueiv-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var hero = document.getElementById('rueiv-hero');
  if (!hero) return;
  var slides = hero.querySelectorAll('.rueiv-hero__slide');
  if (slides.length < 1) return;
  /* Pick one random slide on page load — no timer, no interaction swap */
  var pick = Math.floor(Math.random() * slides.length);
  slides[pick].classList.add('is-active');
  /* Broadcast picked index so other sections can sync */
  document.documentElement.setAttribute('data-hero-slide', pick);
})();
</script>

{% schema %}
{
  "name": "RueIV — Hero",
  "tag": "div",
  "class": "rueiv-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading",
      "default": "YOUR NEXT GENERATION SHOWROOM"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Textiles. Wallcovering. Furniture. Lighting. Rugs."
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Sub-banner statement",
      "default": "An editorial gateway to the showroom — presenting the most compelling pieces from the world's leading design houses. Discover materials, collections, and ideas curated to inspire exceptional interiors."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile Image (optional)" },
        { "type": "text", "id": "kicker", "label": "Kicker (small text above heading)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Design for Interior Professionals" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Button 1 Label", "default": "Explore Textiles" },
        { "type": "url", "id": "button_url", "label": "Button 1 Link" },
        { "type": "text", "id": "button_label_2", "label": "Button 2 Label" },
        { "type": "url", "id": "button_url_2", "label": "Button 2 Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RueIV — Hero",
      "settings": {
        "hero_heading": "YOUR NEXT GENERATION SHOWROOM",
        "hero_subtitle": "Textiles. Wallcovering. Furniture. Lighting. Rugs.",
        "banner_text": "An editorial gateway to the showroom — presenting the most compelling pieces from the world's leading design houses. Discover materials, collections, and ideas curated to inspire exceptional interiors."
      },
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Curated Design for Interior Professionals",
            "description": "Textiles. Wallcovering. Furniture. Lighting. Rugs.\nAn editorial gateway to the showroom.",
            "button_label": "Explore Textiles"
          }
        }
      ]
    }
  ]
}
{% endschema %}
