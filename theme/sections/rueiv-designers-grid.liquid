{%- comment -%}
  RueIV — Designers Grid
  Groups products by vendor, shows one card per vendor using
  the first product's featured image as the visual.
{%- endcomment -%}

<style>
  .rv-designers {
    padding: 0 0 100px;
  }
  .rv-designers__header {
    text-align: center;
    padding: 48px 24px 56px;
  }
  .rv-designers__heading {
    font-family: var(--font-heading-family);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .rv-designers__subtitle {
    font-size: 15px;
    color: rgba(var(--color-foreground), 0.6);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .rv-designers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px 20px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .rv-designers__card {
    text-decoration: none;
    color: rgb(var(--color-foreground));
    display: block;
    text-align: center;
  }
  .rv-designers__img-wrap {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
    background: #f5f3f0;
  }
  .rv-designers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .rv-designers__card:hover .rv-designers__img {
    transform: scale(1.04);
  }
  .rv-designers__name {
    font-family: var(--font-heading-family);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 16px 0 4px;
  }
  .rv-designers__count {
    font-size: 14px;
    color: rgba(var(--color-foreground), 0.5);
  }

  @media (max-width: 989px) {
    .rv-designers__grid { grid-template-columns: repeat(3, 1fr); padding: 0 24px; }
  }
  @media (max-width: 749px) {
    .rv-designers__grid { grid-template-columns: repeat(2, 1fr); gap: 20px 14px; padding: 0 16px; }
    .rv-designers__header { padding: 32px 16px 40px; }
  }
</style>

{%- comment -%}
  The navigation's verified Shopify COLLECTION links are authoritative for the
  Designers directory display. Iterating the first 250 products misses child
  brands, and handleized brand links can select an empty namesake collection.
  Menu is generated by the Hub-published vendor/child-brand reconciliation.
{%- endcomment -%}
{%- assign designer_menu = blank -%}
{%- assign main_menu = linklists['main-menu'] -%}
{%- for top_link in main_menu.links -%}
  {%- if top_link.title == 'Designers' -%}
    {%- assign designer_menu = top_link.links -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if designer_menu == blank -%}
  {%- assign designer_menu = linklists['designers-all'].links -%}
{%- endif -%}

<section class="rv-designers">
  <div class="rv-designers__header">
    <h1 class="rv-designers__heading">{{ section.settings.heading | default: 'The Designers' }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="rv-designers__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>
  <div class="rv-designers__grid">
    {%- for designer_link in designer_menu -%}
      {%- unless designer_link.title == 'All Designers' or designer_link.title == 'View All Designers' -%}
        {%- assign designer_collection = designer_link.object -%}
        {%- assign designer_image = designer_collection.image | default: designer_collection.products.first.featured_image -%}
        <a href="{{ designer_link.url }}" class="rv-designers__card">
          <div class="rv-designers__img-wrap">
            {%- if designer_image != blank -%}
              {{ designer_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'rv-designers__img', alt: designer_link.title }}
            {%- endif -%}
          </div>
          <div class="rv-designers__name">{{ designer_link.title | escape }}</div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RueIV — Designers Grid",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Designers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The makers and visionaries behind our curated collections."
    }
  ],
  "presets": [
    {
      "name": "RueIV — Designers Grid"
    }
  ]
}
{% endschema %}
