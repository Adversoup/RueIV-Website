{{ 'collection.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'smart-filters.css' | asset_url }}" media="print" fetchpriority="low" onload="this.media='all'">
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign current_filter_size = 0
  assign columns_desktop = 3
  assign columns_tablet = 3
  assign columns_tablet_large = 3
  assign columns_mobile = section.settings.columns_mobile | times: 1

  assign break_1_after = 15
  assign break_2_after = 33

  for filter in collection.filters
    assign _dl = filter.label | downcase
    if _dl == 'availability' or filter.type == 'price_range'
      continue
    endif
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor

  assign enable_sorting = section.settings.enable_sorting
  assign enable_filtering = section.settings.enable_filtering
  assign filter_type = section.settings.filter_type
  assign show_toolbar = false
  if enable_filtering or enable_sorting
    assign show_toolbar = true
  endif

  assign default_grid_mobile = 'f-grid-' | append: columns_mobile | append: '-cols'

  assign is_metro = false
  if section.settings.grid_layout == 'metro'
    assign is_metro = true
  endif

  assign breaker_1_image = section.settings.break_1_image
  assign breaker_1_title = section.settings.break_1_title
  assign breaker_1_subtitle = section.settings.break_1_subtitle
  assign breaker_1_cta = section.settings.break_1_cta
  assign breaker_1_link = section.settings.break_1_link
  assign breaker_2_image = section.settings.break_2_image
  assign breaker_2_title = section.settings.break_2_title
  assign breaker_2_subtitle = section.settings.break_2_subtitle
  assign breaker_2_cta = section.settings.break_2_cta
  assign breaker_2_link = section.settings.break_2_link
  assign has_category_breaker = false
  assign parent_collection_handle = collection.handle
  if collection.handle == 'textiles' or collection.handle == 'fabric' or collection.handle contains 'textiles-'
    assign parent_collection_handle = 'textiles'
  elsif collection.handle == 'wallcovering' or collection.handle == 'wallpaper' or collection.handle contains 'wallcovering-'
    assign parent_collection_handle = 'wallcovering'
  elsif collection.handle == 'lighting' or collection.handle contains 'lighting-'
    assign parent_collection_handle = 'lighting'
  elsif collection.handle == 'furniture' or collection.handle contains 'furniture-'
    assign parent_collection_handle = 'furniture'
  elsif collection.handle == 'rugs' or collection.handle contains 'rugs-'
    assign parent_collection_handle = 'rugs'
  elsif collection.handle == 'accessories' or collection.handle contains 'accessories-'
    assign parent_collection_handle = 'accessories'
  endif

  for breaker_block in section.blocks
    if breaker_block.type == 'category_breakers' and breaker_block.settings.collection != blank and breaker_block.settings.collection.handle == parent_collection_handle
      assign has_category_breaker = true
      assign breaker_1_image = breaker_block.settings.break_1_image
      assign breaker_1_title = breaker_block.settings.break_1_title
      assign breaker_1_subtitle = breaker_block.settings.break_1_subtitle
      assign breaker_1_cta = breaker_block.settings.break_1_cta
      assign breaker_1_link = breaker_block.settings.break_1_link
      assign breaker_2_image = breaker_block.settings.break_2_image
      assign breaker_2_title = breaker_block.settings.break_2_title
      assign breaker_2_subtitle = breaker_block.settings.break_2_subtitle
      assign breaker_2_cta = breaker_block.settings.break_2_cta
      assign breaker_2_link = breaker_block.settings.break_2_link
    endif
  endfor
-%}
{%- if is_metro -%}
  {%- render 'product-grid-metro-style',
    section_id: section.id,
    columns_desktop: columns_desktop,
    columns_tablet_large: columns_tablet_large,
    columns_tablet: columns_tablet,
    columns_mobile: columns_mobile
  -%}
{%- endif -%}
{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ columns_mobile }}),
(max-width: 1279px) calc((100vw - 90px) / {{ columns_tablet }}),
{%- if enable_filtering -%}
  calc({{ settings.page_width}}px / {{ columns_desktop | plus: 1 }})
{%- else -%}
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endif -%}
{%- endcapture -%}

<style>
  .collection-breaker { grid-column: 1 / -1; position: relative; min-height: 260px; overflow: hidden; background: #f3f0eb; }
  .collection-breaker__img { display: block; width: 100%; height: 100%; min-height: 260px; object-fit: cover; }
  .collection-breaker__placeholder { min-height: 260px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #d8d0c5, #eee9e1 48%, #b9aa98); color: #fff; font-size: clamp(18px, 2.5vw, 32px); letter-spacing: .12em; text-align: center; text-transform: uppercase; }
  .collection-breaker__overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px; text-align: center; color: #fff; background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.42)); }
  .collection-breaker__title, .collection-breaker__subtitle { margin: 0; color: inherit; }
  .collection-breaker__title { font-size: clamp(24px, 3vw, 42px); letter-spacing: .08em; text-transform: uppercase; }
  .collection-breaker__subtitle { max-width: 560px; margin-top: 10px; font-size: 15px; }
  .collection-breaker__cta { margin-top: 18px; }
</style>

<div
  class="section--padding color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="collection page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="collection__content flex">
        {%- if collection.all_products_count > 0 and enable_filtering and filter_type != 'horizontal' -%}
          <div
            class="hidden{% if filter_type == 'vertical' %} xl:block{% endif %}"
            id="FacetFiltersContainer"
          >
            <div class="sticky-element z-10">
              {%- render 'facets', context: 'vertical', results: collection -%}
            </div>
          </div>
        {%- endif -%}
        <div class="flex flex-col flex-grow{% if show_toolbar %} show-toolbar{% endif %}" id="ProductGridWrapper">
          <div class="sticky-element grid gap-5 z-10" style="--sticky-offset: 0px;">
            {%- if enable_filtering and filter_type == 'horizontal' and collection.all_products_count > 0 -%}
              <div class="collection__toolbar collection__toolbar--horizontal flex items-center justify-between">
                <div class="facets-h__wrap" id="FacetFiltersContainerH">
                  {%- comment -%} Smart filters: category-aware horizontal bar {%- endcomment -%}
                  {%- render 'smart-filters', results: collection, section: section -%}
                </div>
                {%- if enable_sorting -%}
                  <div class="flex items-center gap-3" id="SortByContainerH">
                    {%- render 'facet-short',
                      results: collection,
                      icon_size: 'extra-small',
                      label_class: 'font-body-bolder'
                    -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if enable_filtering or enable_sorting -%}
              <div class="collection__toolbar flex items-center justify-between{% if filter_type == 'horizontal' %} xl:hidden{% endif %}">
                {%- if filter_type == 'drawer' and collection.all_products_count > 0 and enable_filtering -%}
                  {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting -%}
                {%- endif -%}

                {%- if filter_type == 'horizontal' and collection.all_products_count > 0 and enable_filtering -%}
                  <div class="flex xl:hidden">
                    {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting -%}
                  </div>
                {%- endif -%}

                {%- if filter_type == 'vertical' and collection.all_products_count > 0 and enable_filtering -%}
                  <div class="flex xl:hidden">
                    {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting -%}
                  </div>
                {%- endif -%}

                <div class="gap-10 hidden md:flex items-center justify-between{% if filter_type == 'vertical' or enable_filtering == false %} xl:flex-grow{% endif %}">
                  {%- if collection.all_products_count > 0 -%}
                    <div data-facet-loading>
                      {%- render 'loading-spinner' -%}
                      <p id="ProductCount" class="m-0" role="status">
                        {%- liquid
                          if collection.results_count
                            echo 'products.facets.filters_selected' | t: terms: collection.terms, count: collection.results_count
                          elsif collection.products_count == collection.all_products_count
                            echo 'products.facets.product_count_simple' | t: count: collection.products_count
                          else
                            echo 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                          endif
                        -%}
                      </p>
                    </div>
                  {%- endif -%}
                  {%- if enable_sorting and collection.all_products_count > 0 -%}
                    <div class="flex items-center gap-3" id="SortByContainer">
                      {%- render 'facet-short',
                        results: collection,
                        icon_size: 'extra-small',
                        label_class: 'font-body-bolder'
                      -%}
                    </div>
                  {%- endif -%}
                </div>

                <layout-switcher class="flex md:hidden gap-2" style="--buttons-width: 4rem;">
                  {%- for per_row in (1..2) -%}
                    {%- assign layout = 'f-grid-' | append: per_row | append: '-cols' -%}
                    <button
                      class="btn btn--icon{% if layout == default_grid_mobile %} btn--active{% endif %}"
                      data-layout-mode="grid-{{ per_row }}"
                      aria-label="{{ 'accessibility.layout_switcher' | t: col: per_row }}"
                    >
                      {%- render 'icon-grid-column', layout: per_row, classes: 'pointer-events-none' -%}
                    </button>
                  {%- endfor -%}
                </layout-switcher>
              </div>
            {%- endif -%}
          </div>
          {%- liquid
            if enable_filtering
              render 'facets-active', results: collection
            endif
          -%}
          <div id="ProductGridContainer">
            {%- if collection.products.size == 0 -%}
              <div class="empty-state flex flex-col items-center justify-center gap-6 text-center">
                {%- if collection.all_products_count > 0 -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.no_results' | t }}</p>
                    <p class="m-0">{{ 'collections.general.use_fewer_filters' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ collection.url }}" is="facet-remove">
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                {%- else -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.empty' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
                    {{ 'collections.general.continue_shopping' | t }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
            <grid-list
              id="ProductsList"
              class="grid-list products-list f-grid md:f-grid-{{ columns_tablet }}-cols lg:f-grid-{{ columns_tablet_large }}-cols xl:f-grid-{{ columns_desktop }}-cols {{ default_grid_mobile }} f-grid--gap-medium"
            >
              {%- for product in collection.products -%}
                {%- assign grid_weight = product.metafields.override.grid_weight | default: 1 | plus: 0 -%}
                {%- assign is_hero = false -%}
                {%- assign is_featured = false -%}
                {%- if grid_weight >= 3 -%}{%- assign is_hero = true -%}{%- endif -%}
                {%- if grid_weight == 2 -%}{%- assign is_featured = true -%}{%- endif -%}

                <div class="f-column card{% if is_hero %} is-metro-item{% endif %}{% if is_featured %} is-featured-item{% endif %}">
                  {%- if is_metro -%}
                    {%- render 'card-product-metro',
                      product: product,
                      image_sizes: image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index,
                      index0: forloop.index0,
                      desktop_breakpoint: 1280,
                      columns_desktop: columns_desktop,
                      columns_tablet: columns_tablet,
                      columns_mobile: columns_mobile
                    -%}
                  {%- else -%}
                    {%- render 'card-product',
                      product: product,
                      image_sizes: image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index
                    -%}
                  {%- endif -%}
                </div>
                  {%- if forloop.index == break_1_after and has_category_breaker -%}
                    <div class="collection-breaker">
                      {%- if breaker_1_image != blank -%}
                        {{ breaker_1_image | image_url: width: 1440 | image_tag: loading: 'lazy', class: 'collection-breaker__img' }}
                      {%- else -%}
                        <div class="collection-breaker__placeholder"><span>{{ parent_collection_handle | replace: '-', ' ' | capitalize }} — Breaker 1</span></div>
                      {%- endif -%}
                      <div class="collection-breaker__overlay">
                        {%- if breaker_1_title != blank -%}<h3 class="collection-breaker__title">{{ breaker_1_title }}</h3>{%- endif -%}
                        {%- if breaker_1_subtitle != blank -%}<p class="collection-breaker__subtitle">{{ breaker_1_subtitle }}</p>{%- endif -%}
                        {%- if breaker_1_cta != blank and breaker_1_link != blank -%}<a class="btn btn--secondary collection-breaker__cta" href="{{ breaker_1_link }}">{{ breaker_1_cta }}</a>{%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                  {%- if forloop.index == break_2_after and has_category_breaker -%}
                    <div class="collection-breaker">
                      {%- if breaker_2_image != blank -%}
                        {{ breaker_2_image | image_url: width: 1440 | image_tag: loading: 'lazy', class: 'collection-breaker__img' }}
                      {%- else -%}
                        <div class="collection-breaker__placeholder"><span>{{ parent_collection_handle | replace: '-', ' ' | capitalize }} — Breaker 2</span></div>
                      {%- endif -%}
                      <div class="collection-breaker__overlay">
                        {%- if breaker_2_title != blank -%}<h3 class="collection-breaker__title">{{ breaker_2_title }}</h3>{%- endif -%}
                        {%- if breaker_2_subtitle != blank -%}<p class="collection-breaker__subtitle">{{ breaker_2_subtitle }}</p>{%- endif -%}
                        {%- if breaker_2_cta != blank and breaker_2_link != blank -%}<a class="btn btn--secondary collection-breaker__cta" href="{{ breaker_2_link }}">{{ breaker_2_cta }}</a>{%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
              {%- endfor -%}
            </grid-list>
            {%- liquid
              if paginate.pages > 1
                render 'pagination', paginate: paginate, type: section.settings.pagination
              endif
            -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "collection-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://foxecom.link/LgqT3v8)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 50,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "grid_layout",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.product-tabs.settings.grid_layout.options__1.label"
        },
        {
          "value": "metro",
          "label": "t:sections.product-tabs.settings.grid_layout.options__2.label"
        }
      ],
      "default": "standard",
      "info": "t:sections.product-tabs.settings.grid_layout.info",
      "label": "t:sections.product-tabs.settings.grid_layout.label"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main-collection-product-grid.settings.pagination.label",
      "options": [
        {
          "value": "infinite",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__1.label"
        },
        {
          "value": "load_more",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__2.label"
        },
        {
          "value": "number",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__3.label"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatch",
      "label": "t:settings_schema.color_swatches.settings.enable_color_swatch.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal (top bar)"
        },
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "vertical",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label",
      "info": "t:sections.main-collection-product-grid.settings.filter_type.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "text",
      "id": "expand_filter_groups",
      "label": "t:sections.main-collection-product-grid.settings.expand_filter_groups.label",
      "placeholder": "Color, Price, Size",
      "info": "t:sections.main-collection-product-grid.settings.expand_filter_groups.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:sections.all.divider.settings.divider_width.label",
      "visible_if": "{{ section.settings.show_section_divider == true }}"
    }
  ],
  "blocks": [
    {
      "type": "category_breakers",
      "name": "Category breakers",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Category collection"
        },
        {
          "type": "header",
          "content": "Breaker 1"
        },
        {
          "type": "image_picker",
          "id": "break_1_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "break_1_title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "break_1_subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "break_1_cta",
          "label": "CTA label"
        },
        {
          "type": "url",
          "id": "break_1_link",
          "label": "CTA link"
        },
        {
          "type": "header",
          "content": "Breaker 2"
        },
        {
          "type": "image_picker",
          "id": "break_2_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "break_2_title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "break_2_subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "break_2_cta",
          "label": "CTA label"
        },
        {
          "type": "url",
          "id": "break_2_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
